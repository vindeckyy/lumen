# Lumen's firewall rules for nftables.
#
# The host serves three ports: the control plane (TCP 24800), the media the
# client receives (UDP 24801) and the input the client sends (UDP 24820). The
# web console is not in this list: it listens on the loopback by default.
#
# Install:  sudo nft -f packaging/firewall/lumen.nft
#
# The rules follow punktfunk's packaging/linux/punktfunk.ufw (MIT OR
# Apache-2.0, Copyright (c) 2026 unom - Enrico Bühler).

table inet lumen {
    chain input {
        type filter hook input priority 0; policy accept;

        # The control plane: the client dials the host here.
        tcp dport 24800 accept

        # The media the client receives, and the input it sends.
        udp dport 24801 accept
        udp dport 24820 accept
    }
}
